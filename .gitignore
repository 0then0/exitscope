# Rust build output; Cargo.lock is intentionally tracked for this CLI.
/target/
/debug/
**/*.rs.bk
*.pdb
**/mutants.out*/

# Local Python tools, editors and operating-system files.
__pycache__/
*.py[cod]
/.venv/
/.idea/
/.vscode/
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# Local credentials/configuration; sanitized examples may be committed.
.env
.env.*
!.env.example
!.env.*.example

# Validation inputs and curated evidence are tracked; batch output is not.
/validation/*
!/validation/README.md
!/validation/upstream-sources.json
!/validation/upstream-evidence.json
!/validation/examples/
